SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of admin login emails. Required — without it,
# ANY authenticated Supabase user is treated as an admin, both for the
# /admin/* pages (src/lib/supabase/middleware.ts) and the /api/admin/*
# routes (lib/admin-auth.ts). Keep this in sync with the admin_users table
# from supabase/003_pending_changes.sql.
ADMIN_EMAILS=you@yourdomain.com

# Optional. Set the same value in Vercel's project env vars - Vercel Cron
# then sends it as "Authorization: Bearer <value>" automatically when it
# calls /api/cron/*, so only Vercel (not the public internet) can trigger
# them. Safe to leave unset locally.
CRON_SECRET=

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=bookings@yourdomain.com
RESEND_TO_EMAIL=you@yourdomain.com
