SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of admin login emails. Required — without it,
# ANY authenticated Supabase user is treated as an admin, both for the
# /admin/* pages (src/lib/supabase/middleware.ts) and the /api/admin/*
# routes (lib/admin-auth.ts). Keep this in sync with the admin_users table
# from supabase/003_scope_admin_rls_to_admins.sql.
ADMIN_EMAILS=you@yourdomain.com

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=bookings@yourdomain.com
RESEND_TO_EMAIL=you@yourdomain.com
