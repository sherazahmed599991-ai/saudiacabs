SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of admin login emails. Required — without it,
# ANY authenticated Supabase user is treated as an admin, both for the
# /admin/* pages (src/lib/supabase/middleware.ts) and the /api/admin/*
# routes (lib/admin-auth.ts). Keep this in sync with the admin_users table
# from supabase/003_pending_changes.sql.
ADMIN_EMAILS=you@yourdomain.com

# Optional. Set the same value in Vercel's project env vars - Vercel Cron
# then sends it as "Authorization: Bearer <value>" automatically when it
# calls /api/cron/*, so only Vercel (not the public internet) can trigger
# them. Safe to leave unset locally.
CRON_SECRET=

# Outgoing email via ImprovMX SMTP (replaces Resend). ImprovMX ties SMTP
# credentials to one specific alias, so there are two separate logins:
#   - BOOKING_* -> sends the internal "new booking request" notification.
#     BOOKING_NOTIFY_TO is optional; if unset it sends to BOOKING_SMTP_USER
#     itself, relying on ImprovMX's forwarding rule to deliver it to you.
#   - INFO_* -> the "from" identity for quotation/invoice/receipt emails
#     sent to customers from the admin dashboard.
SMTP_HOST=smtp.improvmx.com
SMTP_PORT=587
BOOKING_SMTP_USER=booking@yourdomain.com
BOOKING_SMTP_PASS=your-improvmx-smtp-password
BOOKING_NOTIFY_TO=
INFO_SMTP_USER=info@yourdomain.com
INFO_SMTP_PASS=your-improvmx-smtp-password
